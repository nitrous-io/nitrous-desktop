#= require jquery/jquery-2.0.3
#= require handlebars
#= require ember
#= require ember-model/ember-model-0.0.10
#= require bootstrap3/js/bootstrap
#= require_self
#= require debug
#= require aio/aio
#= require app

appURL = location.origin + location.pathname
console = window.console
gui = require 'nw.gui'
win = gui.Window.get()

uncaughtExceptionHandler = (err) ->
  console.log "Uncaught Exception: #{err.stack}"
  # TODO: airbrake

if process.listeners('uncaughtException').indexOf(uncaughtExceptionHandler) == -1
  process.on 'uncaughtException', uncaughtExceptionHandler

window.NitrousDesktop = Em.Application.extend Ember.Evented,
  rootElement: "#app"
  online: navigator.onLine
  offline: Em.computed.not 'online'
  accessToken: null
  currentUser: null
  userSignedIn: Em.computed.notEmpty 'currentUser'
  applicationView: null

  reset: ->
    @setProperties
      currentUser: null
      accessToken: null
    @_super.apply this, arguments

window.App = NitrousDesktop.create
  config:
    environment: "<%= config['environment'] %>"
    appName: "<%= config['app_name'] %>"
    appVersion: "<%= config['app_version'] %>"
    host: "<%= config['host'] %>"
    apiURI: "<%= config['host'] %>/api/v0"
    clientId: "<%= config['client_id'] %>"
    clientSecret: "<%= config['client_secret'] %>"
    shoverServerURI: "<%= config['shover_server_uri'] %>"

  cleanUp: (cb) ->
    Em.View.views['tray-menu-view']?.hide()
    App.Watcher.stopAll()
    App.PortForwarding.killAll ->
      App.FileSync.killAll ->
        cb?()

  clearAccessTokenAndRestart: ->
    App.AccessToken.removeFromStorage()
    gui.Window.open appURL,
      show: false
      toolbar: false
      focus: true
    @quit()

  quit: ->
    win.hide()
    App.cleanUp =>
      win.close(true)

$(window).on 'online', ->
  App.set 'online', true

$(window).on 'offline', ->
  App.set 'online', false

$html = $('html')

win.on 'focus', ->
  $html.removeClass 'blurred'

win.on 'blur', ->
  $html.addClass 'blurred'

win.on 'close', (kind) ->
  if kind == 'quit'
    App.quit()
  else
    win.hide()

App.on 'AppDidLoad', ->

App.on 'InvalidAccessToken', ->
  App.clearAccessTokenAndRestart()

App.on 'SignOut', ->
  App.clearAccessTokenAndRestart()
