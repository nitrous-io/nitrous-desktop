#= require jquery/jquery-2.0.3
#= require handlebars
#= require ember
#= require ember-model/ember-model-0.0.10
#= require bootstrap3/js/bootstrap
#= require_self
#= require aio/aio
#= require app

gui = require 'nw.gui'
appURL = location.origin + location.pathname

window.NitrousIO = Em.Application.extend Ember.Evented,
  rootElement: "#app"
  online: navigator.onLine
  offline: Em.computed.not 'online'
  accessToken: null
  currentUser: null

  reset: ->
    @setProperties
      currentUser: null
      accessToken: null
    @_super()

window.App = NitrousIO.create
  config:
    environment: "<%= config['environment'] %>"
    appName: "<%= config['app_name'] %>"
    appVersion: "<%= config['app_version'] %>"
    host: "<%= config['host'] %>"
    apiURI: "<%= config['host'] %>/api/v0"
    clientId: "<%= config['client_id'] %>"
    clientSecret: "<%= config['client_secret'] %>"
    shoverServerURI: "<%= config['shover_server_uri'] %>"

$(window).on 'online', ->
  App.set 'online', true

$(window).on 'offline', ->
  App.set 'online', false

$(window).on 'beforeunload', ->
  App.Watcher.stopAll()

win = gui.Window.get()
$html = $('html')

win.on 'focus', ->
  $html.removeClass 'blurred'

win.on 'blur', ->
  $html.addClass 'blurred'

if App.get('config.environment') == 'development'
  $('#debug').show()
  $('#debug .devtools').click ->
    win.showDevTools()
    false
  $('#debug .reload').click ->
    win.reloadIgnoringCache()
    false
  $('#debug .spec').click ->
    gui.Window.open location.href.replace(/index\.html.*/, 'spec/spec.html'),
      position: 'center'
      width: 1024
      height: 768
      toolbar: false
    false

clearAccessTokenAndRestart = ->
  App.AccessToken.removeFromStorage()
  gui.Window.open appURL,
    show: false
    toolbar: false
    focus: true
  win.close()

App.on 'InvalidAccessToken', ->
  clearAccessTokenAndRestart()

App.on 'SignOut', ->
  clearAccessTokenAndRestart()
