#= require jquery/jquery-2.0.3
#= require handlebars
#= require ember
#= require ember-model/ember-model-0.0.10
#= require bootstrap3/js/bootstrap
#= require_self
#= require aio

gui = require 'nw.gui'

window.NitrousIO = Em.Application.extend Ember.Evented,
  rootElement: "#app"
  online: navigator.onLine
  offline: Em.computed.not 'online'
  accessToken: null
  currentUser: null

  reset: ->
    @setProperties
      currentUser: null
      accessToken: null
    @_super()

window.AIO = NitrousIO.create
  config:
    environment: "<%= config['environment'] %>"
    appName: "<%= config['app_name'] %>"
    appVersion: "<%= config['app_version'] %>"
    host: "<%= config['host'] %>"
    clientId: "<%= config['client_id'] %>"
    clientSecret: "<%= config['client_secret'] %>"
    pusherKey: "<%= config['pusher_key'] %>"
    pusherEndpoint: "<%= config['host'] %>/pusher/auth"

$(window).on 'online', ->
  AIO.set 'online', true

$(window).on 'offline', ->
  AIO.set 'online', false

win = gui.Window.get()
$html = $('html')

win.on 'focus', ->
  $html.removeClass 'blurred'

win.on 'blur', ->
  $html.addClass 'blurred'

if AIO.get('config.environment') == 'development'
  $('#debug').show()
  $('#debug .devtools').click ->
    win.showDevTools()
  $('#debug .reload').click ->
    win.reloadIgnoringCache()
  $('#debug .spec').click ->
    gui.Window.open location.href.replace(/index\.html.*/, 'spec/spec.html'),
      position: 'center'
      width: 1024
      height: 768
      toolbar: false

AIO.on 'InvalidAccessToken', ->
  AIO.AccessToken.removeFromStorage()
  AIO.set 'accessToken', null
  AIO.set 'currentUser', null
  AIO.Router.router.transitionTo 'sign-in'
