div class={ :stack-image boxTemplate.runtime }

.info
  .info-row
    .left
    .right
      h3
        = name

  .info-row
    .left State
    .right
      = state

  if ownBox
    .info-row.box-control-row
      .left
      .right
        if running
          button.btn.btn-white click='stop' Shut Down
          button.btn.btn-white click='restart' Restart
        else
          if stopped
            button.btn.btn-white click='start' Start

  .info-row
    .left Memory
    .right
      | {{ memory }} MB

  .info-row
    .left Storage
    .right
      | {{ storage }} MB

  .info-row
    .left Region
    .right
      = region.description

  .info-row
    .left Stack
    .right
      | {{ version }} - {{ boxTemplate.name }}

  if running
    .info-row
      .left SSH URI
      .right.selectable
        = sshURI

    .info-row.has-switch
      .left Port Forwarding
      .right
        = ui-switch preventFastToggling=true enabled=forwardedPorts.enabled
        App.EditableListView label="Port" contentBinding="forwardedPorts"

    .info-row.has-switch
      .left File Sync
      .right
        = ui-switch preventFastToggling=true enabled=fileSync.enabled

    .info-row.box-access
      .left
      .right
        button.btn.btn-white click='ide' IDE
        button.btn.btn-white click='terminal' Terminal
        button.btn.btn-white click='ssh' SSH
