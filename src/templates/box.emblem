div class={ :stack-image boxTemplate.runtime }

.info
  .info-row
    .left
    .right
      h3
        = name

  .info-row
    .left State
    .right
      = state

  if ownBox
    .info-row.box-control-row
      .left
      .right
        if running
          button.btn.btn-white click='stop' Shut Down
          button.btn.btn-white click='restart' Restart
        else
          if stopped
            button.btn.btn-white click='start' Start

  .info-row
    .left Memory
    .right
      | {{ memory }} MB

  .info-row
    .left Storage
    .right
      | {{ storage }} MB

  .info-row
    .left Region
    .right
      = region.description

  .info-row
    .left Stack
    .right
      | {{ version }} - {{ boxTemplate.name }}

  .info-row.port-forwarding
    .left Port Forwarding
    .right
      if forwardedPorts.enabled
        button.btn.btn-white click='togglePortForwarding' Disable Port Forwarding
      else
        button.btn.btn-white click='togglePortForwarding' Enable Port Forwarding
      App.EditableListView label="Port" contentBinding="forwardedPorts"
  .info-row
    .left File Sync
    .right
      if fileSync.enabled
        button.btn.btn-white click='toggleFileSync' Disable File Sync
      else
        button.btn.btn-white click='toggleFileSync' Enable File Sync

  .info-row.box-access
    .left
    .right
      if running
        button.btn.btn-white click='ide' IDE
        button.btn.btn-white click='terminal' Terminal
        button.btn.btn-white click='ssh' SSH
