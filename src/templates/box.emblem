div class={ :stack-image boxTemplate.runtime }

.info
  .info-row
    .left
    .right
      h3
        = name

  .info-row
    .left State
    .right
      = state

  if ownBox
    .info-row.box-control-row
      .left
      .right
        if running
          button.btn.btn-white click='stop' Shut Down
          button.btn.btn-white click='restart' Restart
        else
          if stopped
            button.btn.btn-white click='start' Start

  .info-row
    .left Memory
    .right
      | {{ memory }} MB

  .info-row
    .left Storage
    .right
      | {{ storage }} MB

  .info-row
    .left Region
    .right
      = region.description

  .info-row
    .left Stack
    .right
      | {{ version }} - {{ boxTemplate.name }}

  .info-row.port-forwarding
    .left Port Forwarding
    .right
      label Port
      select multiple='multiple'
        option
          | 3000
        option
          | 4000
      button.btn.btn-simple
        i.icon-plus
        span Add
      button.btn.btn-simple
        i.icon-minus
        span Remove

  .info-row
    .left File Sync
    .right
      button.btn.btn-white Enable File Sync

  .info-row.box-access
    .left
    .right
      button.btn.btn-white click='ide' IDE
      button.btn.btn-white click='terminal' Terminal
      button.btn.btn-white click='ssh' SSH
