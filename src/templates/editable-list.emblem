with view
  if label
    .editable-list-label
      label
        = label
  ul
    each item in content.arrangedContent
      App.EditableListItemView contentBinding="item"
    if addingNewItem
      li
        App.EditableListItemTextField

  button.btn.btn-simple click="add target='view'"
    i.icon-plus
    span Add...
  button.btn.btn-simple click="remove target='view'" disabled={ hasNoSelectedItem }
    i.icon-minus
    span Remove
