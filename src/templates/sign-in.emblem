form submit='signIn'
  fieldset
    .nitrous-logo

    h1 Nitrous.IO

    .form-group
      Em.TextField id='username-field' placeholder='Username' valueBinding="username" disabledBinding="isSaving"

    .form-group
      Em.TextField id='password-field' type='password' placeholder='Password' valueBinding="password" disabledBinding="isSaving"

    .form-group
      button#sign-in-button.native disabled={signInButtonDisabled} Sign In

    .links
      a href='#' click='forgotPassword' Forgot your password?
      .pull-right
        a href='#' click='signUp' Not a user? Sign up
